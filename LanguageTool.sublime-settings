{
    "default_server": "remote",
    "display_mode": "panel",
    "highlight-scope": "comment",
    "ignored-scopes": [
        "support.function.*.latex",
        "meta.*.latex",
        "comment.*.tex",
        "keyword.control.tex"
    ],

    /* [OPTION] The path to your Java binary.

    Use this option if you have more than one Java on your machine to prevent conflicts.

    The value of this option should be the absolute path to your Java binary, including the file name.
    Example value: C:/Program Files/OpenJDK/jdk-25/bin/java.exe */
    "java_path": "java",

    /* [OPTION] Absolute path to your “languagetool-server.jar” file.
    Ensure that you don’t specify the path to files “languagetool.jar” or “languagetool-commandline.jar”. */
    "languagetool_jar": "D:/Chocolatey/tools/languagetool/languagetool-server.jar",

    "languagetool_server_local": "http://localhost:8081/v2/check",
    "languagetool_server_remote": "https://languagetool.org/api/v2/check"
}
